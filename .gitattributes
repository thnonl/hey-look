# Source is LF on every platform: several tests read the source files (include_str!, readFileSync) and match multi-line text,
# which fails on a Windows checkout with core.autocrlf=true (CRLF). Binary files are detected by git and left untouched.
* text=auto eol=lf
*.sh text eol=lf
# the binary APT key must never go through line-ending conversion
docs/apt/*.gpg binary
*.wav binary
# the PDF fixtures of the viewer tests: byte offsets in the cross-reference table, never converted
scripts/fixtures/pdf/*.pdf binary

# Partner Center export (CRLF rows, BOM, empty rows at the end): kept byte for byte, the test reads the exact bytes
scripts/fixtures/store-listing/*.csv -text
