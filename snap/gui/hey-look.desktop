Keywords[de]=e-mail;email;mail;e-mails;post;postfach;mailclient;mailprogramm;imap;smtp;gmail;outlook;kalender;termine;pgp;openpgp;verschlüsselung;
Keywords[ru]=почта;письма;электронная почта;email;имейл;почтовый клиент;imap;gmail;outlook;календарь;pgp;
