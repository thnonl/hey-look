{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hey Look!",
  "version": "1.0.6",
  "identifier": "thnonl.heylook",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hey Look!",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 560,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; frame-src blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "thnonl",
    "copyright": "© 2026 thnonl",
    "homepage": "https://heylook.namthai.site/",
    "license": "MIT",
    "category": "Productivity",
    "shortDescription": "Fast, private desktop mail client",
    "longDescription": "Hey Look! is a free, open-source desktop mail client for Google, Microsoft, iCloud, Yahoo and any IMAP/SMTP mailbox.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "files": {
          "usr/share/metainfo/hey-look.appdata.xml": "../linux/io.github.thnonl.HeyLook.metainfo.xml"
        }
      },
      "deb": {
        "files": {
          "/usr/share/metainfo/io.github.thnonl.HeyLook.metainfo.xml": "../linux/io.github.thnonl.HeyLook.metainfo.xml"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/metainfo/io.github.thnonl.HeyLook.metainfo.xml": "../linux/io.github.thnonl.HeyLook.metainfo.xml"
        }
      }
    },
    "windows": {
      "nsis": {
        "installerHooks": "nsis/hooks.nsh"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0ODM2QTZBRDgwODg3OTQKUldTVWh3allhbXFEZE9DWUVrTGI2MUxkRjlmc0hwWUxBQ3hsUEVnenlieXlCVStjZUVhQjZWWGsK",
      "endpoints": ["https://github.com/thnonl/hey-look/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
