{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "event",
  "description": "Capability for the event windows (event-*, W4.6): the window basics and the calendar commands the event form needs (read, save, delete an event, the calendars it can write to, contact suggestions). Nothing of accounts, secrets, settings, quit, update or mail actions (REQ-S2, W4.9).",
  "windows": [
    "event-*"
  ],
  "permissions": [
    "core:event:default",
    "core:window:default",
    "core:app:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-start-dragging",
    "core:window:allow-set-title",
    "core:window:allow-set-focus",
    "opener:default",
    "allow-popout-init",
    "allow-popout-ready",
    "allow-popout-focus",
    "allow-popout-close",
    "allow-popout-destroy",
    "allow-popout-note",
    "allow-window-theme-refresh",
    "allow-popout-request",
    "allow-popout-flush-alive",
    "allow-popout-flush-dialog",
    "allow-popout-flush-done",
    "allow-get-setting",
    "allow-shell-info",
    "allow-list-accounts",
    "allow-calendar-list-calendars",
    "allow-calendar-get-event",
    "allow-calendar-save-event",
    "allow-calendar-delete-event",
    "allow-suggest-contacts"
  ]
}
