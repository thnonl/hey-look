{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "popout",
  "description": "Capability for the secondary windows (compose-*, reader-*): the few window actions a pop-out needs and an allowlist of app commands. Denied for them: accounts, secrets, PGP key management, settings write, rules, autostart, update, quit, calendar connect, sync (REQ-S2). No window may create windows.",
  "windows": [
    "compose-*",
    "reader-*"
  ],
  "permissions": [
    "core:event:default",
    "core:window:default",
    "core:app:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-start-dragging",
    "core:window:allow-set-title",
    "core:window:allow-set-focus",
    "core:window:allow-set-content-protected",
    "opener:default",
    "allow-list-accounts",
    "allow-list-folders",
    "allow-get-thread",
    "allow-get-raw",
    "allow-reply-headers",
    "allow-get-setting",
    "allow-has-secret",
    "allow-shell-info",
    "allow-save-draft",
    "allow-draft-recipients",
    "allow-draft-editor-parts",
    "allow-draft-data",
    "allow-draft-upload",
    "allow-discard-draft",
    "allow-discard-draft-changes",
    "allow-send-message",
    "allow-outbox-hold",
    "allow-outbox-hold-send",
    "allow-outbox-send-now",
    "allow-cancel-outbox",
    "allow-outbox-open-for-edit",
    "allow-outbox-update",
    "allow-outbox-release",
    "allow-outbox-to-draft",
    "allow-recovery-save",
    "allow-recovery-clear",
    "allow-recovery-list",
    "allow-recovery-load",
    "allow-smtp-size-limit",
    "allow-list-signatures",
    "allow-list-templates",
    "allow-suggest-contacts",
    "allow-pgp-list-keys",
    "allow-pgp-public-armored",
    "allow-pgp-recipient-status",
    "allow-pgp-unlock",
    "allow-pgp-decrypt-message",
    "allow-ai-complete",
    "allow-ai-cancel",
    "allow-attachment-data",
    "allow-attachment-save-as",
    "allow-attachment-save-all",
    "allow-attachment-open",
    "allow-attachment-reveal",
    "allow-save-attachments",
    "allow-inline-image",
    "allow-fetch-remote-images",
    "allow-pick-folder",
    "allow-calendar-respond",
    "allow-calendar-add-from-message",
    "allow-calendar-save-ics",
    "allow-calendar-delete-event",
    "allow-unsubscribe",
    "allow-unsubscribe-opened",
    "allow-open-external",
    "allow-copy-text",
    "allow-read-clipboard-text",
    "allow-popout-open",
    "allow-popout-init",
    "allow-popout-ready",
    "allow-popout-focus",
    "allow-popout-close",
    "allow-popout-park",
    "allow-popout-destroy",
    "allow-popout-note",
    "allow-window-theme-refresh",
    "allow-popout-set-key",
    "allow-popout-show",
    "allow-drag-begin",
    "allow-drag-peek",
    "allow-drag-take",
    "allow-drag-end",
    "allow-popout-request",
    "allow-thread-meta",
    "allow-popout-flush-alive",
    "allow-popout-flush-dialog",
    "allow-popout-flush-done"
  ]
}
