{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "scheduled",
  "description": "Capability for the Scheduled list window (scheduled-*, W4.6): the window basics and the outbox commands the list needs (list, open for edit, release, retry, send now, cancel, to Drafts) with the passphrase of an encrypted message. Nothing of accounts, secrets, settings, quit or update (REQ-S2, W4.9).",
  "windows": [
    "scheduled-*"
  ],
  "permissions": [
    "core:event:default",
    "core:window:default",
    "core:app:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-start-dragging",
    "core:window:allow-set-title",
    "core:window:allow-set-focus",
    "opener:default",
    "allow-popout-init",
    "allow-popout-ready",
    "allow-os-color-scheme",
    "allow-popout-focus",
    "allow-popout-close",
    "allow-popout-destroy",
    "allow-popout-note",
    "allow-window-theme-refresh",
    "allow-popout-request",
    "allow-popout-flush-alive",
    "allow-popout-flush-dialog",
    "allow-popout-flush-done",
    "allow-get-setting",
    "allow-shell-info",
    "allow-popout-open",
    "allow-list-accounts",
    "allow-list-outbox",
    "allow-outbox-open-for-edit",
    "allow-outbox-release",
    "allow-outbox-retry",
    "allow-outbox-send-now",
    "allow-cancel-outbox",
    "allow-outbox-to-draft",
    "allow-pgp-unlock",
    "allow-pgp-list-keys"
  ]
}
