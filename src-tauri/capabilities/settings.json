{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "Capability for the Settings window (settings-*, W4.6): the window basics and the commands the Settings dialog calls (accounts, sign-in, secrets, PGP keys, signatures, templates, rules, autostart, calendar connections, test notification, the update check, download and defer, set_setting for every key except prefs, which the backend refuses from any window but main). Denied: quit, the quit protocol, frontend_ready, page_state, page_pong, popout_reply, popout_save_all, update_install (the restart is asked of the main window), thread_action, queue_action and the frame commands (REQ-4.6.12, W4.9).",
  "windows": [
    "settings-*"
  ],
  "permissions": [
    "core:event:default",
    "core:window:default",
    "core:app:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-start-dragging",
    "core:window:allow-set-title",
    "core:window:allow-set-focus",
    "opener:default",
    "allow-popout-init",
    "allow-popout-ready",
