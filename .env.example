# Google OAuth client (type "Desktop app") for "Sign in with Google".
# Copy this file to `.env` (git-ignored) or set real environment variables.
# Read at build time (`npm run tauri build`) and embedded in the binary; also read at runtime, where the
# environment variable overrides the embedded value (handy for `npm run tauri dev`).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
