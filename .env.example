# OAuth clients for "Sign in with Google" and "Sign in with Microsoft".
# Copy this file to `.env` (git-ignored) or set real environment variables.
# Read at build time (`npm run tauri build`) and embedded in the binary; also read at runtime, where the
# environment variable overrides the embedded value (handy for `npm run tauri dev`).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google: OAuth client of type "Desktop app" (Gmail API enabled).
# Microsoft: Entra app registration (personal + work accounts) with a "Mobile and desktop applications"
# platform and redirect URI http://localhost. It is a public client, so the secret stays empty.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
