{
  "_about": "The cases of resolveModelsUrl (src/aiModelsUrl.ts) and of ai::resolve_models_url (src-tauri/src/ai.rs) for Settings > AI Assistant > Advanced > Model list URL (1.0.7 W8.11). Both sides run every case: `result` is \"none\" (no Base URL: no request), \"invalid\" (a coded error, no request) or the address that is asked; `origin` is the origin of that address (scheme + host + the port unless it is the default one). `valueLen` replaces `value` by \"/\" followed by that many minus one letters.",
  "cases": [
    { "name": "no Base URL and no list URL", "base": "", "value": "", "result": "none" },
    { "name": "no Base URL beats the list URL", "base": "   ", "value": "/x", "result": "none" },
    { "name": "empty list URL: the Base URL and /models, as it always was", "base": "https://api.openai.com/v1", "value": "", "result": "https://api.openai.com/v1/models", "origin": "https://api.openai.com" },
    { "name": "a trailing slash of the Base URL and a list URL of spaces", "base": "https://api.openai.com/v1/", "value": "   ", "result": "https://api.openai.com/v1/models", "origin": "https://api.openai.com" },
    { "name": "mode (b) is not parsed: a Base URL that is no URL is still base + /models", "base": "myserver/v1", "value": "", "result": "myserver/v1/models" },
    { "name": "a path replaces the Base URL's path (Ollama)", "base": "http://localhost:11434/v1", "value": "/api/tags", "result": "http://localhost:11434/api/tags", "origin": "http://localhost:11434" },
    { "name": "user info and a port of the Base URL are kept", "base": "http://user:pw@host.test:8080/v1", "value": "/api/tags", "result": "http://user:pw@host.test:8080/api/tags", "origin": "http://host.test:8080" },
    { "name": "a query is kept, the fragment is dropped", "base": "https://x.test/v1", "value": "/x?api-version=1#frag", "result": "https://x.test/x?api-version=1", "origin": "https://x.test" },
    { "name": "just a slash", "base": "https://x.test/v1", "value": "/", "result": "https://x.test/", "origin": "https://x.test" },
    { "name": "a space in the path is encoded", "base": "https://x.test", "value": "/a b", "result": "https://x.test/a%20b", "origin": "https://x.test" },
    { "name": "an absolute https URL is used as typed, fragment dropped", "base": "https://x.test/v1", "value": "https://y.test/models?key=A#f", "result": "https://y.test/models?key=A", "origin": "https://y.test" },
    { "name": "an absolute URL in capitals", "base": "https://x.test/v1", "value": "HTTP://Y.TEST/m", "result": "http://y.test/m", "origin": "http://y.test" },
    { "name": "an absolute URL with no path gets the slash", "base": "https://x.test/v1", "value": "http://y.test", "result": "http://y.test/", "origin": "http://y.test" },
    { "name": "an absolute URL with a port that is the default one", "base": "https://x.test/v1", "value": "https://y.test:443/m", "result": "https://y.test/m", "origin": "https://y.test" },
    { "name": "an absolute URL with a space", "base": "https://x.test/v1", "value": "http://y.test/a b", "result": "http://y.test/a%20b", "origin": "http://y.test" },
    { "name": "the default port of the Base URL is dropped", "base": "https://x.test:443/v1", "value": "/a", "result": "https://x.test/a", "origin": "https://x.test" },
    { "name": "scheme and host of the Base URL in capitals", "base": "HTTPS://X.TEST/v1", "value": "/a", "result": "https://x.test/a", "origin": "https://x.test" },
    { "name": "an IPv6 Base URL", "base": "https://[::1]:8080/v1", "value": "/api/tags", "result": "https://[::1]:8080/api/tags", "origin": "https://[::1]:8080" },
    { "name": "an international host name", "base": "https://bücher.test/v1", "value": "/x", "result": "https://xn--bcher-kva.test/x", "origin": "https://xn--bcher-kva.test" },
    { "name": "// is another host, not a path", "base": "https://x.test/v1", "value": "//y.test/m", "result": "invalid" },
    { "name": "/\\ would be another host for a browser", "base": "https://x.test/v1", "value": "/\\evil.test/x", "result": "invalid" },
    { "name": "a tab and // after trimming", "base": "https://x.test/v1", "value": "\t//y.test/m", "result": "invalid" },
    { "name": "ftp", "base": "https://x.test/v1", "value": "ftp://y.test/m", "result": "invalid" },
    { "name": "javascript", "base": "https://x.test/v1", "value": "javascript:alert(1)", "result": "invalid" },
    { "name": "a data URL", "base": "https://x.test/v1", "value": "data:text/plain,x", "result": "invalid" },
    { "name": "a file URL", "base": "https://x.test/v1", "value": "file:///etc/passwd", "result": "invalid" },
    { "name": "a relative word", "base": "https://x.test/v1", "value": "models", "result": "invalid" },
    { "name": "a query only", "base": "https://x.test/v1", "value": "?x=1", "result": "invalid" },
    { "name": "no host", "base": "https://x.test/v1", "value": "https://", "result": "invalid" },
    { "name": "no host with a port", "base": "https://x.test/v1", "value": "http://:80/x", "result": "invalid" },
    { "name": "2,001 characters", "base": "https://x.test/v1", "value": "", "valueLen": 2001, "result": "invalid" },
    { "name": "2,000 characters are allowed", "base": "https://x.test", "value": "", "valueLen": 2000, "result": "long", "origin": "https://x.test" },
    { "name": "a path needs a Base URL that is a URL", "base": "not a url", "value": "/x", "result": "invalid" },
    { "name": "a path needs an http(s) Base URL", "base": "ftp://x.test/v1", "value": "/x", "result": "invalid" },
    { "name": "a path needs a Base URL with a host", "base": "https://", "value": "/x", "result": "invalid" },
    { "name": "an absolute URL does not need a Base URL that is a URL", "base": "not a url", "value": "https://y.test/m", "result": "https://y.test/m", "origin": "https://y.test" }
  ]
}
